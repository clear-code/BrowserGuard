{
  "NetLogger": {
    "Enabled": false,
    "UrlAccess": false,
    "Browsing": false,
    "Upload": false,
    "Download": false,
    "Print": false,
    "LocalFile": {
      "Enabled": true,
      "Directory": "%LOCALAPPDATA%\\BrowserGuard\\netlog",
      "MaxDays": 30,
      "MaxSizeMB": 100
    },
    "Sender": {
      "Enabled": false,
      "Endpoint": "",
      "OnSendFailure": {
        "SaveLocally": true,
        "RetryIntervalMinutes": 5,
        "MaxSizeMB": 10
      }
    }
  },
  "UploadGuard": {
    "Enabled": false,
    "BlockedExtensions": [".exe", ".bat", ".cmd", ".js", ".vbs"],
    "AllowedExtensions": [".pdf", ".docx", ".xlsx"],
    "AllowedPaths": ["^C:\\\\Users\\\\[^\\\\]+\\\\Documents\\\\", "^D:\\\\Share\\\\"],
    "BlockedPaths": ["\\\\Confidential\\\\"]
  },
  "SettingPageFilter": {
    "Enabled": false,
    "NotifyOnBlocked": true,
    "BlockedPrefixes": ["edge://settings/"]
  },
  "StartupLauncher": {
    "Enabled": false,
    "Programs": [
      {
        "Path": "C:\\Tools\\EnvDump.exe",
        "Arguments": [],
        "WorkingDirectory": "C:\\Temp\\envdump",
        "EnvironmentVariables": { "BROWSERGUARD_STARTUP_TEST": "from-config" },
        "Sha256": ""
      }
    ]
  },
  "UsageTimeLimit": {
    "Enabled": false,
    "MaxContinuousMinutes": 240,
    "AllowedTimeRanges": [
      { "Start": "09:00", "End": "12:00" },
      { "Start": "13:00", "End": "18:00" }
    ],
    "OnExceeded": {
      "Action": "Terminate",
      "GraceSeconds": 60,
      "ReWarnIntervalMinutes": 10
    }
  },
  "TabCountLimit": {
    "Enabled": false,
    "MaxCount": 20
  },
  "UploadFileBridge": {
    "Enabled": false,
    "Destination": "\\\\fileserver\\audit\\%PCNAME%\\%USERID%\\%DATE%",
    "MaxSizeMB": 100,
    "BlockedExtensions": [".tmp", ".log"],
    "AllowedExtensions": [],
    "BlockedUrls": ["^https://example.com\\."],
    "AllowedUrls": []
  }
}
